# --- Application configuration ---
APP_PORT=8501

# --- API ---
API_HOST=api
API_PORT=8500

# --- SQL ---
SQL_USER=admin_sql
SQL_PASSWORD=pass_sql
SQL_DB=db_saude_sql
SQL_HOST=db_sql
SQL_PORT=5432

# --- NoSQL ---
MONGO_USER=admin_nosql
MONGO_PASSWORD=pass_nosql
MONGO_DB=db_saude_nosql
MONGO_HOST=db_nosql
MONGO_PORT=27017

# --- Vector store ---
VECTOR_DB_PATH=./chroma_db
VECTOR_HOST=db_vector
VECTOR_PORT=8002

# --- Langfuse (local initialization) ---
# These values are used only for self-hosted local dev.
# Each developer should run the stack locally (option A), so they get their own persistent Langfuse instance.
#
# Langfuse headless init variables:
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=Default Org
LANGFUSE_INIT_PROJECT_ID=default-project
LANGFUSE_INIT_PROJECT_NAME=ProjetoEC
LANGFUSE_INIT_PROJECT_RETENTION=30
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=adminadminadmin

