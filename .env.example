# --- Application configuration ---
APP_PORT=8501

# --- API ---
API_HOST=api
API_PORT=8500

# Optional: run apps/api/eval.py cases once when the API process starts (writes eval_report.txt by default).
# RUN_STARTUP_EVAL=1
# EVAL_REPORT_PATH=eval_report.txt
# Treat missing Ollama as failure for tool/dashboard cases instead of skip.
# EVAL_REQUIRE_OLLAMA=0

# --- LLM ---
LLM_MODEL=gemma3:1b
OLLAMA_HOST=http://ollama:11434

# --- SQL ---
SQL_USER=admin_sql
SQL_PASSWORD=pass_sql
SQL_DB=db_saude_sql
SQL_HOST=db_sql
SQL_PORT=5432

# --- NoSQL ---
MONGO_USER=admin_nosql
MONGO_PASSWORD=pass_nosql
MONGO_DB=db_saude_nosql
MONGO_HOST=db_nosql
MONGO_PORT=27017

# --- Vector store ---
# Chroma data persists in the Docker named volume `chroma_data` (see docker-compose db_vector).
# VECTOR_DB_PATH is not used by the server; the API uses HttpClient (VECTOR_HOST / VECTOR_PORT).
VECTOR_HOST=db_vector
# Published host port for Chroma (container still uses 8000 internally). Avoid 8000 if Portainer or other tools use it.
VECTOR_PORT=8010

# --- Langfuse (local initialization) ---
# These values are used only for self-hosted local dev.
# Each developer should run the stack locally (option A), so they get their own persistent Langfuse instance.
#
# Langfuse headless init variables:
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=Default Org
LANGFUSE_INIT_PROJECT_ID=default-project
LANGFUSE_INIT_PROJECT_NAME=ProjetoEC
LANGFUSE_INIT_PROJECT_RETENTION=30
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=adminadminadmin

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-fbcd8953-c162-44b5-b528-fa83bc914e35
LANGFUSE_SECRET_KEY=sk-lf-e386b4e1-0842-4f77-922b-322ba96a1f28
# Host runs (make eval): localhost. Compose overrides to http://langfuse:3000 for app/api.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET='65v/fXoNjaeXlAQUJCPxdHkIvPCfF3bWf08AabqMKmU='
LANGFUSE_SALT='Aqht/ko4GTkLoq3OeUMEHMJODkQqVJKOhrnQHwxIN7I='
LANGFUSE_ENCRYPTION_KEY=554b79b9be387e34dfdabea64b56978bd391690b93cc174c5fd949091ce758b1